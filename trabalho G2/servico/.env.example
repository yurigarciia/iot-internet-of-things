# Copie para .env (NAO versionar). Valores que precisam ser IGUAIS aos do ESP32 / Worker:
GRUPO=yuripaim
SILO=silo01
MQTT_HOST=test.mosquitto.org
MQTT_PORT=8883

# Mesma chave do HMAC_KEY em esp32/silo/config.h
HMAC_KEY=troque-por-uma-chave-aleatoria
SLEEP_S=30

# Worker local (npm run dev) ou o publicado em https://silo-iot.SEU-USUARIO.workers.dev
WORKER_URL=http://127.0.0.1:8788
TOKEN_ESCRITA=mesmo-valor-de-TOKEN_ESCRITA-do-worker/.dev.vars

# Token que o PAINEL usa para falar com esta ponte (invente um, longo)
TOKEN_COMANDO=troque-este-token-do-painel

COOLDOWN_S=1800
UMID_CRITICA=80
BAT_BAIXA_V=3.4
